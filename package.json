{
  "name": "fictional-guacamole",
  "version": "1.0.0",
  "description": "simple todoapp to experiment with ts, typeorm and express js",
  "author": "Adam Krawiec",
  "license": "ISC",
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.72.1",
    "prettier": "^3.9.10",
    "supertest": "7.3.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
