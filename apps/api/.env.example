# Copy to .env (git-ignored) and adjust.
PORT=8000

# Local Postgres from docker-compose.yml (`docker compose up -d` at the repo root)
POSTGRES_PORT=5433
DATABASE_URL=postgres://guac:guac@localhost:5433/guacamole

# Better Auth. Generate a secret with: openssl rand -base64 32
# Optional locally (a dev default is used, with a warning); required in production.
BETTER_AUTH_SECRET=
# Public URL the browser uses: the Vite dev server locally, the CloudFront URL in production.
# Better Auth rejects requests from any other origin ("Invalid origin").
BETTER_AUTH_URL=http://localhost:5173
