# Copy to .env (git-ignored). Read by docker-compose.yml for the local Postgres.
# If you change these, update DATABASE_URL in apps/api/.env to match.
POSTGRES_USER=guac
POSTGRES_PASSWORD=guac

# Optional: host port, if 5432 is already taken by another Postgres
POSTGRES_PORT=5433

# Optional: Mailpit host ports (defaults 1025 SMTP, 8025 web inbox)
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
